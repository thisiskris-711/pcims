# ==============================================================
# Block PHP execution in uploads directory
# Prevents uploaded malicious PHP files from being executed
# ==============================================================

# Disable PHP engine in this directory
<IfModule mod_php.c>
    php_flag engine Off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine Off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine Off
</IfModule>

# Block direct access to PHP files
<FilesMatch "\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Also block other potentially executable file types
<FilesMatch "\.(phtml|php3|php4|php5|phps|phar|sh|pl|py|cgi|asp|aspx|jsp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
